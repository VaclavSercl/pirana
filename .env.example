# PIRANA Environment Configuration
# Copy to .env and fill in values

# Bitfinex API (WITHDRAWALS MUST BE DISABLED)
BITFINEX_API_KEY=your_api_key_here
BITFINEX_API_SECRET=your_api_secret_here

# Set to "true" for testnet
PIRANA_TESTNET=false

# Risk overrides (optional — defaults are in constants.rs)
# MAX_AGGREGATE_EXPOSURE=0.20
# MAX_SINGLE_TRADE_RISK=0.005
# MAX_DAILY_DRAWDOWN=0.03
# MAX_WEEKLY_DRAWDOWN=0.07
# CONSECUTIVE_LOSS_THRESHOLD=5

# Infrastructure — safe defaults bind locally; reverse proxy/container may opt in
PIRANA_RUST_METRICS_PORT=9100
HEALTH_CHECK_PORT=8080
PIRANA_DASHBOARD_BIND=127.0.0.1
PIRANA_METRICS_BIND=127.0.0.1
PIRANA_EXPORTER_BIND=127.0.0.1
PIRANA_EXPORTER_PORT=9091
LOG_LEVEL=info
PIRANA_ENV=production

# Durable state (defaults shown)
PIRANA_ACCOUNTING_DB=/var/lib/pirana/accounting.sqlite3
PIRANA_ACCOUNTING_SNAPSHOT_PATH=/var/lib/pirana/accounting_snapshot.json
PIRANA_POSITION_SNAPSHOT_PATH=/var/lib/pirana/positions.json
CASLAV_RISK_STATE_PATH=/opt/caslav/risk/risk_state.json

# Grafana
GRAFANA_PASSWORD=change_me_in_production

# Telegram control/reporting — no hardcoded fallback exists
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
