# PIRANA least-privilege control plane
# Validate before install:
#   visudo -cf deploy/sudoers/pirana-ops
#
# Install as /etc/sudoers.d/pirana-ops with mode 0440.
# This file intentionally grants NO shell, reboot, package, file-edit, network,
# user-management or arbitrary systemctl privileges.

wwwenda ALL=(root) NOPASSWD: /usr/bin/systemctl start pirana.service
wwwenda ALL=(root) NOPASSWD: /usr/bin/systemctl stop pirana.service
wwwenda ALL=(root) NOPASSWD: /usr/bin/systemctl restart pirana.service
