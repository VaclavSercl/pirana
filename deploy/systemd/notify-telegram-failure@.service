[Unit]
Description=Notify Telegram about failed systemd unit %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wwwenda
Group=wwwenda
WorkingDirectory=/home/wwwenda/workspace/pirana
EnvironmentFile=/etc/pirana/telegram.env
InaccessiblePaths=-/home/wwwenda/workspace/pirana/.env
ExecStart=/usr/bin/python3 /home/wwwenda/workspace/pirana/scripts/send_alert.py %i
TimeoutStartSec=30
UMask=0077
PrivateTmp=true
