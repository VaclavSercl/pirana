[Unit]
Description=Pirana trading engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wwwenda
Group=wwwenda
WorkingDirectory=/home/wwwenda/workspace/pirana

# Exchange credentials are exposed only inside this systemd unit's credential
# mount. They are not stored in the project .env and are not inherited by the
# Hermes audit/control-plane unit.
LoadCredential=bitfinex_api_key:/etc/pirana/credentials/bitfinex_api_key
LoadCredential=bitfinex_api_secret:/etc/pirana/credentials/bitfinex_api_secret

Environment=PIRANA_ENV=production
Environment=PIRANA_LOAD_DOTENV=0
Environment=PIRANA_DASHBOARD_BIND=127.0.0.1
Environment=PIRANA_METRICS_BIND=127.0.0.1
Environment=PIRANA_RUST_METRICS_PORT=9100

ExecStartPre=/usr/bin/python3 /home/wwwenda/workspace/pirana/scripts/strategy_versioning.py validate
ExecStart=/home/wwwenda/workspace/pirana/target/release/pirana
Restart=always
RestartSec=5
LimitNOFILE=65535
UMask=0077
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
