[Unit]
Description=Pirana monthly quantitative R&D proposal
After=network-online.target pirana.service
Wants=network-online.target
OnFailure=notify-telegram-failure@%n.service

[Service]
Type=oneshot
User=wwwenda
Group=wwwenda
WorkingDirectory=/home/wwwenda/workspace/pirana
EnvironmentFile=/home/wwwenda/workspace/pirana/.env
ExecStart=/usr/bin/python3 /home/wwwenda/workspace/pirana/scripts/send_monthly_proposal.py
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
UMask=0077
